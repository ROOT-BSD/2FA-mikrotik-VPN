# VPN-GW configuration. Copy to .env, fill in, chmod 600.
# Generate keys:  php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'

APP_ENV=production
# Неочевидний шлях порталу: лише літери, цифри, _ та -
APP_BASE_PATH=/k7f3x
# 32 байти: шифрування секретів TOTP (sodium secretbox). ВТРАТА = повторна реєстрація всіх.
APP_KEY=base64:
# 32 байти: HMAC для Email OTP
APP_HMAC_KEY=base64:

# Apache передає справжню IP у REMOTE_ADDR; X-Forwarded-For враховується лише від цих адрес
TRUSTED_PROXIES=127.0.0.1
# Звідки дозволена реєстрація TOTP (/enroll), через кому
INTERNAL_NETWORKS=10.0.0.0/8

# Active Directory
LDAP_HOSTS=ldaps://dc01.company.local:636,ldaps://dc02.company.local:636
LDAP_UPN_SUFFIX=@company.local
LDAP_BASE_DN=DC=company,DC=local
LDAP_VPN_GROUP_DN=CN=VPN-Users,OU=Groups,DC=company,DC=local
LDAP_CA_FILE=/etc/ssl/company-ca.pem

# Пошта (сповіщення і резервний Email OTP). SMTP_HOST порожній = листи вимкнено.
EMAIL_OTP_ENABLED=false
SMTP_HOST=mail.company.local
SMTP_PORT=587
SMTP_USER=vpn-gw@company.ua
SMTP_PASS=
SMTP_FROM=vpn-gw@company.ua
SMTP_CA_FILE=/etc/ssl/company-ca.pem
IT_CONTACT="ІТ-служба, тел. +380 XX XXX XX XX"

# Маршрутизатори MikroTik: version 7 = REST API (www-ssl), 6 = API-SSL. JSON — в одинарних лапках.
ROUTERS='[{"name":"core","host":"10.0.10.1","version":7,"port":8443},{"name":"branch","host":"10.0.20.1","version":6,"port":8729}]'
MT_USER=vpn_portal
MT_PASS=
MT_CA_FILE=/etc/ssl/company-ca.pem
MT_LIST=Allowed_VPN_Users
MT_TIMEOUT=10:00:00

# Ліміти: спроб/секунд
RATE_LOGIN_IP=5/900
# Має бути МЕНШЕ порогу блокування облікового запису в AD
RATE_LOGIN_USER=3/900
RATE_MFA_ATTEMPTS=3
RATE_EMAIL_OTP=3/3600
LOCKOUT_SECONDS=900

DB_PATH=/var/lib/vpn-gw/db.sqlite
LOCK_DIR=/var/lib/vpn-gw/locks
LOG_PATH=/var/lib/vpn-gw/logs/audit.log
