# VPN-GW configuration. Copy to .env, fill in, chmod 600 (install.sh does this).
# Generate keys:  php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
#
# MikroTik, пошту, AD, журнали і резервне копіювання зручніше налаштовувати в панелі
# адміністратора: https://<домен><APP_BASE_PATH>/admin (лише з INTERNAL_NETWORKS).
# Значення з панелі мають пріоритет над цим файлом; перелік: bin/settings.php list.
# Тільки в .env: APP_*, TRUSTED_PROXIES, INTERNAL_NETWORKS, RATE_*, LOCKOUT_SECONDS, DB_PATH, LOCK_DIR.

APP_ENV=production
# Неочевидний шлях порталу: лише літери, цифри, _ та -
APP_BASE_PATH=/k7f3x
# 32 байти: шифрування секретів TOTP (sodium secretbox). ВТРАТА = повторна реєстрація всіх.
APP_KEY=base64:
# 32 байти: HMAC для Email OTP
APP_HMAC_KEY=base64:

# Apache передає справжню IP у REMOTE_ADDR; X-Forwarded-For враховується лише від цих адрес
TRUSTED_PROXIES=127.0.0.1
# Приватні мережі, з яких дозволено вхід на портал (IP додається в address-list), через кому.
# За замовчуванням — лише публічні IP клієнтів. Приклад: тестування з офісу.
#PRIVATE_CLIENT_NETWORKS=172.20.2.0/23

# Звідки дозволені реєстрація TOTP (/enroll) і панель адміністратора (/admin), через кому
INTERNAL_NETWORKS=10.0.0.0/8

# Active Directory
# Режим: ldaps (з перевіркою сертифіката, рекомендовано) | ldaps-insecure | starttls | starttls-insecure | plain
# Для starttls* і plain адреси — ldap://...:389; CA потрібен лише для ldaps і starttls.
LDAP_SECURITY=ldaps
LDAP_HOSTS=ldaps://dc01.company.local:636,ldaps://dc02.company.local:636
# Домен AD: з нього виводяться логін user@домен і база пошуку (DC=...). Вхід — user або user@домен.
LDAP_DOMAIN=company.local
# Назва групи VPN в AD (вкладені групи враховуються)
LDAP_VPN_GROUP=VPN-Users
LDAP_CA_FILE=/etc/ssl/company-ca.pem

# Пошта (сповіщення і резервний Email OTP). SMTP_HOST порожній = листи вимкнено.
EMAIL_OTP_ENABLED=false
SMTP_HOST=mail.company.local
SMTP_PORT=587
SMTP_USER=vpn-gw@company.ua
SMTP_PASS=
SMTP_FROM=vpn-gw@company.ua
SMTP_CA_FILE=/etc/ssl/company-ca.pem
IT_CONTACT="ІТ-служба, тел. +380 XX XXX XX XX"
# PDF-пам'ятка «Як підключатися до VPN», що надсилається після реєстрації автентифікатора на вказаний e-mail.
# Порожньо — doc/VPN-GW_Інструкція_підключення.pdf з архіву порталу.
#USER_GUIDE_PDF=
# Адреса порталу для доступу ззовні (з Інтернету) — додається до листів користувачам. Порожньо — не додається.
# Можна змінити в панелі: «Пошта».
PORTAL_EXTERNAL_URL=https://vpn-gw.nerc.gov.ua:11443/heou

# Маршрутизатори MikroTik: version 7 = REST API (www-ssl), 6 = API-SSL. JSON — в одинарних лапках.
# "transport": "api" (RouterOS 7 REST / RouterOS 6 API-SSL, за замовчуванням) або "ssh".
# Параметри підключення краще задавати в панелі адміністратора: там вони зберігаються зашифрованими,
# а в цьому файлі — відкритим текстом.
ROUTERS='[{"name":"core","host":"10.0.10.1","version":7,"port":8443},{"name":"branch","host":"10.0.20.1","version":6,"port":8729}]'
# Власний address-list маршрутизатора — поле "list" у ROUTERS (порожньо — MT_LIST).
# "disabled": true — маршрутизатор тимчасово відключено (налаштування зберігаються; панель: «Відключити»).
# Хоча б один маршрутизатор має бути без "disabled".
# Власний користувач маршрутизатора — поле "user" у ROUTERS, власний пароль — ROUTER_PASSWORDS
# (JSON {"назва": "пароль"}). Без них маршрутизатор використовує типові облікові дані протоколу
# (MT_USER/MT_PASS для API, MT_SSH_USER/MT_SSH_PASS для SSH). Приклад:
#ROUTERS='[{"name":"core","host":"10.0.10.1","version":7,"port":8443,"user":"portal_core"},{"name":"branch","host":"10.0.20.1","version":6,"port":8729}]'
#ROUTER_PASSWORDS='{"core":"пароль-core"}'
# Протокол API — типові облікові дані:
MT_USER=vpn_portal
MT_PASS=
MT_CA_FILE=/etc/ssl/company-ca.pem
# Протокол SSH — типові облікові дані (пароль і/або приватний ключ; ключ хоста підтверджується в панелі):
#MT_SSH_USER=vpn_portal
#MT_SSH_PASS=
#MT_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
#...
#-----END OPENSSH PRIVATE KEY-----"
#MT_SSH_KEY_PASS=
MT_LIST=Allowed_VPN_Users
MT_TIMEOUT=10:00:00

# Ліміти: спроб/секунд
RATE_LOGIN_IP=5/900
# Має бути МЕНШЕ порогу блокування облікового запису в AD
RATE_LOGIN_USER=3/900
RATE_MFA_ATTEMPTS=3
RATE_EMAIL_OTP=3/3600
LOCKOUT_SECONDS=900

DB_PATH=/var/lib/vpn-gw/db.sqlite
LOCK_DIR=/var/lib/vpn-gw/locks
LOG_PATH=/var/lib/vpn-gw/logs/audit.log

# Журнали (також у панелі → Журнали)
#LOG_LEVEL=info                 # info | warning
#LOG_EVENTS=auth,access,enroll,mail,admin,system
#LOG_SYSLOG=true
#LOG_SYSLOG_FACILITY=local5
#LOG_REMOTE=                    # siem.company.local:514 (UDP)
#LOG_RETENTION_DAYS=180

# Резервні копії (також у панелі → Резервні копії). Пароль генерує install.sh.
#BACKUP_ENABLED=true
#BACKUP_HOUR=2
#BACKUP_KEEP=14
#BACKUP_PASSPHRASE=

# Каталоги (змінювати лише разом з install.sh)
#DATA_DIR=/var/lib/vpn-gw
#AGENT_DIR=/var/lib/vpn-gw-agent
#BACKUP_DIR=/var/backups/vpn-gw
