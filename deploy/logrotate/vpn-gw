# /etc/logrotate.d/vpn-gw — initial version. After installation the VPN-GW agent
# rewrites this file from the admin panel settings (Журнали: file location, days to keep).
/var/lib/vpn-gw/logs/*.log {
    daily
    rotate 180
    maxage 180
    compress
    delaycompress
    missingok
    notifempty
    su vpngw vpngw
    create 0600 vpngw vpngw
}
