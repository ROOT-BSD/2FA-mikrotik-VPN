{
    "name": "company/vpn-gw",
    "description": "VPN-GW: two-factor Dynamic Knocking portal for MikroTik L2TP/IPsec VPN",
    "version": "0.10.9",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-ldap": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "ext-sockets": "*",
        "ext-sodium": "*",
        "endroid/qr-code": "^5.1",
        "evilfreelancer/routeros-api-php": "^1.5",
        "monolog/monolog": "^3.0",
        "paragonie/constant_time_encoding": "^2.6 || ^3.0",
        "phpmailer/phpmailer": "^6.9",
        "psr/clock": "^1.0",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "spomky-labs/otphp": "^11.2",
        "vlucas/phpdotenv": "^5.6",
        "phpseclib/phpseclib": "^3.0.47"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "VpnGw\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VpnGw\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "suggest": {
        "ext-gmp": "Faster SSH key exchange for routers accessed over SSH (phpseclib)"
    }
}
